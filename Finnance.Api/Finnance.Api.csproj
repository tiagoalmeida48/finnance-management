<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <RootNamespace>Finnance.Api</RootNamespace>
        <AssemblyName>Finnance.Api</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Web / API -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.10" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />

        <!-- Data access -->
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
        <PackageReference Include="Npgsql" Version="9.0.4" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />

        <!-- HTTP clients (Refit) -->
        <PackageReference Include="Refit" Version="8.0.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />

        <!-- Security / crypto / auth -->
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
        <PackageReference Include="Otp.NET" Version="1.4.0" />
        <PackageReference Include="QRCoder" Version="1.7.0" />

        <!-- Directory services (LDAP / AD) -->
        <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
        <PackageReference Include="System.DirectoryServices" Version="9.0.10" />
        <PackageReference Include="System.DirectoryServices.Protocols" Version="9.0.10" />

        <!-- Serialization / utils -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="SpanJson" Version="4.2.1" />
        <PackageReference Include="Csv" Version="2.0.170" />

        <!-- DI / logging (frameworks transitivamente presentes no SDK Web, fixados por compatibilidade) -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\swagger\login.html" />
        <_ContentIncludedByDefault Remove="wwwroot\swagger\script.js" />
        <_ContentIncludedByDefault Remove="wwwroot\swagger\style.css" />
        <_ContentIncludedByDefault Remove="wwwroot\swagger\swagger-integration.js" />
        <_ContentIncludedByDefault Remove="wwwroot\authentication-api\swagger\login.html" />
        <_ContentIncludedByDefault Remove="wwwroot\authentication-api\swagger\script.js" />
        <_ContentIncludedByDefault Remove="wwwroot\authentication-api\swagger\style.css" />
        <_ContentIncludedByDefault Remove="wwwroot\authentication-api\swagger\swagger-integration.js" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Modules\BankAccount\Repository\Repositories\" />
      <Folder Include="Modules\Category\Application\Dto\" />
      <Folder Include="Modules\Category\Application\Interfaces\" />
      <Folder Include="Modules\Category\Application\Services\CategoryService\" />
      <Folder Include="Modules\Category\Domain\Entities\" />
      <Folder Include="Modules\PaymentMethod\Repository\Models\" />
      <Folder Include="Modules\PaymentMethod\Repository\Repositories\" />
      <Folder Include="Modules\RecurringGroup\Application\Dto\" />
      <Folder Include="Modules\RecurringGroup\Application\Interfaces\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Modules\BankAccount\Repository\Repositories\BankAccountRepository.cs" />
      <Compile Remove="Modules\Category\Application\Dto\CategoryCreateDto.cs" />
      <Compile Remove="Modules\Category\Application\Dto\CategoryDisplayDto.cs" />
      <Compile Remove="Modules\RecurringGroup\Application\Dto\RecurringGroupCreateDto.cs" />
      <Compile Remove="Modules\RecurringGroup\Application\Services\RecurringGroupService\RecurringGroupGetService.cs" />
      <Compile Remove="Modules\Transaction\Application\Dto\BatchPayDto.cs" />
    </ItemGroup>

</Project>
